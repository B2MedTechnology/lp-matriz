# Copie para .env (nunca commitar). Só os NOMES ficam aqui.
OPENROUTER_API_KEY=        # IA do conteúdo, da ficha e do verificador (Gemini 2.5 Pro pelo OpenRouter)
VERCEL_TOKEN=              # publicar as prévias (projeto novo por página, noindex)
VERCEL_TEAM_ID=            # opcional: o time da Vercel onde as prévias nascem
SUPABASE_URL=              # só a fábrica (fila lp_pedidos)
SUPABASE_SERVICE_ROLE=     # só a fábrica — nunca no navegador
ORQ_VAULT_KEY=             # opcional: ler os segredos de um cofre cifrado no banco em vez do ambiente
TENANT=padrao              # opcional: separa os segredos por empresa no cofre
# A esteira de vídeo tem as suas em video/ferramentas/.env.exemplo (GEMINI_API_KEY, OPENAI_API_KEY)
